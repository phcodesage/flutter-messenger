<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox disabled so flutter_secure_storage can reach the macOS Keychain
	     without a signed keychain-access-group entitlement (no Apple team / paid
	     membership needed). Suitable for ad-hoc-signed internal distribution; the
	     app is not eligible for the Mac App Store while non-sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
